# InterBeat Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# ── Shared secrets (used by all services) ────────────────────────────────────
SECRET_KEY=change-me-in-production
DEVICE_BRIDGE_KEY=change-me-in-production
DASHBOARD_API_KEY=change-me-in-production

# ── interview-webapp-backend (port 5000) ──────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
DB_NAME=interbeat_interview
JWT_EXPIRY_HOURS=24
DEVICE_MONITOR_URL=http://localhost:8081
CORS_ORIGINS=*
UPLOAD_FOLDER=uploads
PORT=5000

# ── device-monitor-backend (port 8081) ────────────────────────────────────────
MONGO_URI_DEVICE=mongodb://localhost:27017
DB_NAME_DEVICE=interbeat_monitoring
BRIDGE_URL=http://localhost:5000
PORT_DEVICE=8081

# ── gateway (port 8080) ───────────────────────────────────────────────────────
GATEWAY_PORT=8080
INTERVIEW_API_URL=http://localhost:5000
DEVICE_MONITOR_API_URL=http://localhost:8081
PROXY_TIMEOUT=30
GATEWAY_CORS_ORIGINS=*
